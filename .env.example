# Copy to .env and fill in real values.

# OpenAI / OpenAI-compatible endpoint
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Repository to analyze (optional; can also pass --repo / -r)
CODE_WATCH_REPO=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code-watch
LANGSMITH_TRACING=true

# Defects4J home (optional; defaults to ./defects4j)
DEFECTS4J_HOME=
